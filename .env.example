# Never store real credentials in this file or commit them to Git.
KOMPLIANCE_EMAIL=
KOMPLIANCE_PASSWORD=

# Required fail-closed acknowledgement for any approved production read.
KOMPLIANCE_READ_ONLY_ACK=I_UNDERSTAND_READ_ONLY

# Enable only the operation covered by written data-owner approval.
KOMPLIANCE_EXPORT_AUTHORIZED=NO
KOMPLIANCE_DOWNLOAD_AUTHORIZED=NO

# Record the approver and a ticket/email/contract reference.
KOMPLIANCE_AUTHORIZED_BY=
KOMPLIANCE_AUTHORIZATION_REFERENCE=
