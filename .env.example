# Never store real credentials in this file or commit them to Git.
KOMPLIANCE_EMAIL=
KOMPLIANCE_PASSWORD=

# Required fail-closed acknowledgement for any approved production read.
KOMPLIANCE_READ_ONLY_ACK=I_UNDERSTAND_READ_ONLY

# Enable only the operation covered by written data-owner approval.
KOMPLIANCE_EXPORT_AUTHORIZED=NO
KOMPLIANCE_DOWNLOAD_AUTHORIZED=NO

# Record the approver and a ticket/email/contract reference.
KOMPLIANCE_AUTHORIZED_BY=
KOMPLIANCE_AUTHORIZATION_REFERENCE=

# Local application release settings. External delivery remains disabled until
# the approvals in DATA_GOVERNANCE.md are recorded.
KOMPLIANCE_SCHEDULER=0
KOMPLIANCE_SCHEDULER_INTERVAL_SECONDS=3600
KOMPLIANCE_EMAIL_DELIVERY=0
KOMPLIANCE_BASE_URL=
KOMPLIANCE_SMTP_HOST=
KOMPLIANCE_SMTP_PORT=587
KOMPLIANCE_SMTP_SECURITY=starttls
KOMPLIANCE_SMTP_USERNAME=
KOMPLIANCE_SMTP_PASSWORD=
KOMPLIANCE_SMTP_FROM=
KOMPLIANCE_COMPLIANCE_RECIPIENT=
KOMPLIANCE_PRIVACY_CONTACT=
